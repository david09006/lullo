# =============================================================================
# Lullo — environment variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# MUST NEVER be committed. Only PUBLIC_* values are safe to expose to the client
# bundle; everything else stays server-side. NEVER put a Shopify Admin API token
# anywhere in this project — it is not needed for a storefront and would be a
# critical leak.
# =============================================================================

# --- Sessions --------------------------------------------------------------
# Strong random string used to sign cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED. Do not ship the placeholder value.
SESSION_SECRET="CHANGE_ME_generate_a_32_byte_random_hex_string"

# --- Storefront API --------------------------------------------------------
# The store this storefront reads products/collections/cart from.
#
# DEFAULT (no real store yet): leave as `mock.shop`. Lullo also ships a local
# on-brand catalog adapter (app/lib/catalog) that renders the dog-calm products
# regardless of this value; the Storefront client is wired and ready.
#
# TO GO LIVE  <-- PLUG IN YOUR REAL STORE HERE:
#   1. Set PUBLIC_STORE_DOMAIN to your-store.myshopify.com
#   2. Create a Storefront API access token (Shopify admin > Headless / Hydrogen
#      channel, or a custom app with Storefront API scopes) and set it below.
#   3. Set CATALOG_SOURCE=shopify to switch the adapter to live Storefront data.
PUBLIC_STORE_DOMAIN="mock.shop"

# Public Storefront API access token. Safe to expose to the client (read-only,
# scoped). Leave blank while using mock.shop.  <-- PLUG IN REAL TOKEN HERE
PUBLIC_STOREFRONT_API_TOKEN=""

# Optional: server-only Storefront token (delegate access token) for private
# server requests. Never exposed to the client.
PRIVATE_STOREFRONT_API_TOKEN=""

# Optional identifiers used by Hydrogen analytics / Oxygen.
PUBLIC_STOREFRONT_ID=""
PUBLIC_CHECKOUT_DOMAIN=""

# Which data source the catalog adapter reads from: `local` (on-brand mock
# catalog, the default) or `shopify` (live Storefront API).
CATALOG_SOURCE="local"

# --- Customer Accounts (optional; only if you enable login/accounts) --------
# From the Customer Account API settings in your Shopify admin.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""

# --- Webhooks (optional) ----------------------------------------------------
# Your Shopify app's webhook signing secret. Required only if you register
# webhooks to /webhooks/shopify; requests are HMAC-verified and rejected if unset.
SHOPIFY_WEBHOOK_SECRET=""
